<UserControl x:Class="PTRP.App.Views.Calendar.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:PTRP.ViewModels.Calendar;assembly=PTRP.ViewModels"
             xmlns:converters="clr-namespace:PTRP.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CalendarViewModel}"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
        <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header con titolo e navigazione mese -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="📅 Calendario Appuntamenti" 
                       Style="{StaticResource MaterialDesignHeadline4TextBlock}" 
                       VerticalAlignment="Center" />

            <!-- Navigazione mese -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Command="{Binding GoToPreviousMonthCommand}" 
                        ToolTip="Mese precedente"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Margin="0,0,5,0">
                    <materialDesign:PackIcon Kind="ChevronLeft" />
                </Button>

                <TextBlock Text="{Binding CurrentMonthDisplay}" 
                           FontSize="18" FontWeight="SemiBold" 
                           VerticalAlignment="Center" 
                           MinWidth="150" TextAlignment="Center"
                           Margin="5,0" />

                <Button Command="{Binding GoToNextMonthCommand}" 
                        ToolTip="Mese successivo"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Margin="5,0">
                    <materialDesign:PackIcon Kind="ChevronRight" />
                </Button>

                <Button Command="{Binding GoToTodayCommand}" 
                        Content="Oggi" 
                        Margin="10,0,0,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>
        </Grid>

        <!-- Contenuto principale: Grid calendario + Lista appuntamenti -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- PANNELLO SINISTRO: Calendario Mensile + Filtri + Legenda -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Calendario mensile -->
                    <materialDesign:Card Grid.Row="0" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header giorni settimana -->
                            <UniformGrid Grid.Row="0" Rows="1" Columns="7" Margin="0,0,0,10">
                                <TextBlock Text="L" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueDarkBrush}" />
                                <TextBlock Text="M" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueDarkBrush}" />
                                <TextBlock Text="M" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueDarkBrush}" />
                                <TextBlock Text="G" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueDarkBrush}" />
                                <TextBlock Text="V" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueDarkBrush}" />
                                <TextBlock Text="S" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueDarkBrush}" />
                                <TextBlock Text="D" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueDarkBrush}" />
                            </UniformGrid>

                            <!-- Griglia giorni -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="6" Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"
                                                Height="60" Margin="2"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                            <Button.Background>
                                                <SolidColorBrush Color="{Binding BadgeColor}" Opacity="0.1" />
                                            </Button.Background>

                                            <Border BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#007ACC|Transparent'}" 
                                                    BorderThickness="2" CornerRadius="4" Padding="5">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Numero giorno -->
                                                    <TextBlock Grid.Row="0" Text="{Binding DayNumber}" 
                                                               HorizontalAlignment="Right" 
                                                               FontWeight="{Binding IsToday, Converter={StaticResource BoolToFontWeightConverter}}" 
                                                               Foreground="{Binding IsCurrentMonth, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Black|Gray'}" />

                                                    <!-- Badge appuntamenti -->
                                                    <Ellipse Grid.Row="1" Width="8" Height="8" 
                                                             Fill="{Binding BadgeColor}" 
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Visibility="{Binding HasAppointments, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Legenda Stati Progetto -->
                    <materialDesign:Card Grid.Row="1" Padding="15" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Legenda (Stato Progetto):" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                                    <Ellipse Width="12" Height="12" Fill="#28A745" VerticalAlignment="Center" />
                                    <TextBlock Text="Active" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                                    <Ellipse Width="12" Height="12" Fill="#FFC107" VerticalAlignment="Center" />
                                    <TextBlock Text="Suspended" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                                    <Ellipse Width="12" Height="12" Fill="#6C757D" VerticalAlignment="Center" />
                                    <TextBlock Text="Completed" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Ellipse Width="12" Height="12" Fill="#000000" VerticalAlignment="Center" />
                                    <TextBlock Text="Deceased" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Filtri -->
                    <materialDesign:Card Grid.Row="2" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Filtri:" FontWeight="SemiBold" Margin="0,0,0,10" />

                            <!-- Tipo Appuntamento -->
                            <WrapPanel Margin="0,0,0,10">
                                <CheckBox Content="Prima Apertura" IsChecked="{Binding FilterIntake}" Margin="0,0,15,5" />
                                <CheckBox Content="Verifiche" IsChecked="{Binding FilterVerifiche}" Margin="0,0,15,5" />
                                <CheckBox Content="Dimissioni" IsChecked="{Binding FilterDimissioni}" Margin="0,0,0,5" />
                            </WrapPanel>

                            <!-- Educatore -->
                            <ComboBox materialDesign:HintAssist.Hint="Educatore" 
                                      ItemsSource="{Binding EducatorFilterOptions}" 
                                      SelectedValue="{Binding SelectedEducatorFilter}" 
                                      DisplayMemberPath="Name" 
                                      SelectedValuePath="Id" 
                                      Margin="0,0,0,10" />

                            <!-- Stato Progetto -->
                            <ComboBox materialDesign:HintAssist.Hint="Stato Progetto" 
                                      ItemsSource="{Binding ProjectStateFilterOptions}" 
                                      SelectedItem="{Binding SelectedProjectStateFilter}" 
                                      Margin="0,0,0,10" />

                            <!-- Bottone Applica Filtri -->
                            <Button Command="{Binding ApplyFiltersCommand}" 
                                    Content="Applica Filtri" 
                                    Style="{StaticResource MaterialDesignRaisedButton}" />
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </ScrollViewer>

            <!-- PANNELLO DESTRO: Appuntamenti del Giorno Selezionato -->
            <materialDesign:Card Grid.Column="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0" 
                               Text="{Binding SelectedDate, StringFormat='Appuntamenti del {0:dd/MM/yyyy}', FallbackValue='Seleziona un giorno'}" 
                               FontSize="16" FontWeight="SemiBold" 
                               Margin="0,0,0,20" />

                    <!-- Lista appuntamenti o messaggio vuoto -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- Appuntamenti -->
                            <ItemsControl ItemsSource="{Binding SelectedDayAppointments}" 
                                          Visibility="{Binding HasSelectedDayAppointments, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                BorderThickness="0,0,0,1" 
                                                Padding="0,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <!-- Tipo + Ora -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                    <Ellipse Width="10" Height="10" 
                                                             Fill="{Binding ProjectStateBadgeColor}" 
                                                             VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock Text="{Binding VisitTypeDisplay}" FontWeight="SemiBold" />
                                                    <TextBlock Text=" - " />
                                                    <TextBlock Text="{Binding TimeDisplay}" />
                                                </StackPanel>

                                                <!-- Paziente -->
                                                <TextBlock Text="{Binding PatientName}" FontSize="15" Margin="0,0,0,3" />

                                                <!-- Progetto -->
                                                <TextBlock Margin="0,0,0,3">
                                                    <Run Text="Progetto:" FontWeight="SemiBold" />
                                                    <Run Text="{Binding ProjectTitle}" />
                                                    <Run Text="(" />
                                                    <Run Text="{Binding ProjectStateDisplay}" />
                                                    <Run Text=")" />
                                                </TextBlock>

                                                <!-- Educatori -->
                                                <TextBlock Margin="0,0,0,10">
                                                    <Run Text="Educatori:" FontWeight="SemiBold" />
                                                    <Run Text="{Binding EducatorNames}" />
                                                </TextBlock>

                                                <!-- Azioni (solo se CanManage) -->
                                                <WrapPanel Margin="0,0,0,5" Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                                                    <Button Content="Registra Visita" 
                                                            Command="{Binding DataContext.RegisterVisitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Style="{StaticResource MaterialDesignRaisedButton}" 
                                                            Margin="0,0,10,5" />

                                                    <Button Content="Riprogramma" 
                                                            Command="{Binding DataContext.RescheduleAppointmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                                                            Margin="0,0,10,5" />

                                                    <Button Content="Segna Mancato" 
                                                            Command="{Binding DataContext.MarkAsMissedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                                                            Margin="0,0,0,5" />
                                                </WrapPanel>

                                                <!-- Status se completato/mancato -->
                                                <TextBlock Text="✅ Visita Registrata" 
                                                           Foreground="Green" FontWeight="SemiBold" 
                                                           Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />

                                                <TextBlock Text="❌ Appuntamento Mancato" 
                                                           Foreground="Red" FontWeight="SemiBold" 
                                                           Visibility="{Binding IsMissed, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Messaggio nessun appuntamento -->
                            <TextBlock Text="{Binding NoAppointmentsMessage}" 
                                       Foreground="Gray" FontStyle="Italic" 
                                       TextAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasSelectedDayAppointments, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
