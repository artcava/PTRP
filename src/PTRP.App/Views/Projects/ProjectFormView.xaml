<UserControl x:Class="PTRP.App.Views.Projects.ProjectFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:PTRP.ViewModels.Projects;assembly=PTRP.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:ProjectFormViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="600"
             Background="{DynamicResource MaterialDesignPaper}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    
    <materialDesign:Card UniformCornerRadius="8" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    Padding="16">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Nuovo Progetto Terapeutico"
                                 Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                 Foreground="White"/>
                        <TextBlock Text="{Binding PatientFullName, StringFormat='Paziente: {0}'}"
                                 Style="{StaticResource MaterialDesignBody2TextBlock}"
                                 Foreground="White"
                                 Opacity="0.9"
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <!-- Loading indicator -->
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                               Value="0"
                               IsIndeterminate="True"
                               Width="24"
                               Height="24"
                               HorizontalAlignment="Right"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Border>
            
            <!-- Form Content -->
            <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        Padding="16">
                <StackPanel>
                    
                    <!-- Title -->
                    <TextBox materialDesign:HintAssist.Hint="Titolo Progetto *"
                           Style="{StaticResource MaterialDesignOutlinedTextBox}"
                           Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,0,16"
                           MaxLength="200"/>
                    
                    <!-- Description -->
                    <TextBox materialDesign:HintAssist.Hint="Descrizione (opzionale)"
                           Style="{StaticResource MaterialDesignOutlinedTextBox}"
                           Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                           TextWrapping="Wrap"
                           AcceptsReturn="True"
                           MinLines="3"
                           MaxLines="6"
                           VerticalScrollBarVisibility="Auto"
                           Margin="0,0,0,16"/>
                    
                    <!-- Dates -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <DatePicker Grid.Column="0"
                                  materialDesign:HintAssist.Hint="Data Inizio *"
                                  Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                  SelectedDate="{Binding StartDate}"/>
                        
                        <DatePicker Grid.Column="2"
                                  materialDesign:HintAssist.Hint="Data Fine Prevista"
                                  Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                  SelectedDate="{Binding PlannedEndDate}"/>
                    </Grid>
                    
                    <!-- State -->
                    <ComboBox materialDesign:HintAssist.Hint="Stato Iniziale"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            ItemsSource="{Binding AvailableStates}"
                            SelectedItem="{Binding SelectedProjectState}"
                            Margin="0,0,0,16">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="Active">
                                                    <Setter Property="Text" Value="Attivo"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Suspended">
                                                    <Setter Property="Text" Value="Sospeso"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    
                    <!-- Educators Section -->
                    <TextBlock Text="Educatori Assegnati *"
                             Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                             Margin="0,8,0,8"/>
                    
                    <TextBlock Text="Selezionare almeno un educatore per il progetto"
                             Style="{StaticResource MaterialDesignCaptionTextBlock}"
                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                             Margin="0,0,0,8"/>
                    
                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                          BorderThickness="1"
                          CornerRadius="4"
                          MaxHeight="200"
                          Margin="0,0,0,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AvailableEducators}"
                                        Padding="8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <CheckBox Grid.Column="0"
                                                        IsChecked="{Binding IsSelected}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"/>
                                                
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}"
                                                             FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Role}"
                                                             FontSize="12"
                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    
                    <!-- Generate Appointments Checkbox -->
                    <CheckBox IsChecked="{Binding GenerateCanonicalAppointments}"
                            Margin="0,0,0,16">
                        <CheckBox.Content>
                            <StackPanel>
                                <TextBlock Text="Genera automaticamente appuntamenti programmati (4)"
                                         FontWeight="SemiBold"/>
                                <TextBlock FontSize="12"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                         TextWrapping="Wrap">
                                    <Run Text="• Prima Apertura: +3 mesi"/>
                                    <LineBreak/>
                                    <Run Text="• Verifica Intermedia: +6 mesi"/>
                                    <LineBreak/>
                                    <Run Text="• Verifica Finale: +6 mesi"/>
                                    <LineBreak/>
                                    <Run Text="• Dimissioni: +1 mese"/>
                                </TextBlock>
                            </StackPanel>
                        </CheckBox.Content>
                    </CheckBox>
                    
                    <!-- Success Message -->
                    <Border Background="{DynamicResource PrimaryHueLightBrush}"
                          Padding="12"
                          CornerRadius="4"
                          Margin="0,0,0,8"
                          Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircle"
                                                   Width="20"
                                                   Height="20"
                                                   Foreground="White"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SuccessMessage}"
                                     Foreground="White"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Error Message -->
                    <Border Background="{DynamicResource MaterialDesignValidationErrorBrush}"
                          Padding="12"
                          CornerRadius="4"
                          Margin="0,0,0,8"
                          Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircle"
                                                   Width="20"
                                                   Height="20"
                                                   Foreground="White"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                     Foreground="White"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </ScrollViewer>
            
            <!-- Action Buttons -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0,1,0,0"
                    Padding="16"
                    Background="{DynamicResource MaterialDesignPaper}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0"
                          Style="{StaticResource MaterialDesignOutlinedButton}"
                          Content="Annulla"
                          Command="{Binding CancelCommand}"
                          HorizontalAlignment="Left"
                          Padding="24,8"/>
                    
                    <Button Grid.Column="1"
                          Style="{StaticResource MaterialDesignRaisedButton}"
                          Command="{Binding SaveCommand}"
                          IsEnabled="{Binding CanSave}"
                          Padding="24,8">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                       Value="0"
                                       IsIndeterminate="True"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,8,0"
                                       Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="Crea Progetto"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            
        </Grid>
    </materialDesign:Card>
</UserControl>
