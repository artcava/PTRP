<UserControl x:Class="PTRP.App.Views.Sync.ConflictResolutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:PTRP.ViewModels;assembly=PTRP.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:ConflictResolutionViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <!-- Converter per visibilità -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal"
                      Margin="0,0,0,8">
                <materialDesign:PackIcon Kind="AlertDecagram"
                                       Width="32"
                                       Height="32"
                                       Foreground="{DynamicResource SecondaryHueMidBrush}"
                                       Margin="0,0,12,0"/>
                <TextBlock Text="Risoluzione Conflitti"
                         Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Sono stati rilevati conflitti durante l'importazione. Scegli quale versione mantenere per ciascun conflitto."
                     Style="{StaticResource MaterialDesignBody2TextBlock}"
                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Progress Bar -->
        <materialDesign:Card Grid.Row="1"
                           UniformCornerRadius="8"
                           Margin="0,0,0,24">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <materialDesign:PackIcon Grid.Column="0"
                                       Kind="CheckCircle"
                                       Width="32"
                                       Height="32"
                                       VerticalAlignment="Center">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AllConflictsResolved}" Value="True">
                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>

                <!-- Progress Details -->
                <StackPanel Grid.Column="2"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                              Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                 Margin="0,0,8,0">
                            <Run Text="{Binding ResolvedConflictsCount}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding TotalConflictsCount}"/>
                        </TextBlock>
                        <TextBlock Text="conflitti risolti"
                                 Style="{StaticResource MaterialDesignBody2TextBlock}"
                                 Foreground="{DynamicResource MaterialDesignBodyLight}"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <ProgressBar Value="{Binding ResolutionProgress}"
                               Maximum="100"
                               Height="8"
                               Style="{StaticResource MaterialDesignLinearProgressBar}"/>
                </StackPanel>

                <!-- Percentage -->
                <TextBlock Grid.Column="4"
                         Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                         VerticalAlignment="Center">
                    <Run Text="{Binding ResolutionProgress, StringFormat='{}{0:F0}'}"/>
                    <Run Text="%"/>
                </TextBlock>
            </Grid>
        </materialDesign:Card>

        <!-- Conflicts List -->
        <ScrollViewer Grid.Row="2"
                     VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Conflicts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card UniformCornerRadius="8"
                                           Margin="0,0,0,16">
                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header: Tipo Conflitto + Status -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                              Orientation="Horizontal">
                                        <Border Background="{Binding TypeColor}"
                                              CornerRadius="4"
                                              Padding="8,4"
                                              VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="{Binding TypeIcon}"
                                                                       Width="16"
                                                                       Height="16"
                                                                       Foreground="White"
                                                                       Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding TypeDisplay}"
                                                         Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                         Foreground="White"
                                                         FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="1"
                                          CornerRadius="12"
                                          Padding="12,4"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibility}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CheckCircle"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Foreground="#4CAF50"
                                                                   Margin="0,0,4,0"/>
                                            <TextBlock Text="Risolto"
                                                     Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                     Foreground="#4CAF50"
                                                     FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Comparison Grid -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LOCAL VERSION -->
                                    <Border Grid.Column="0"
                                          BorderBrush="#2196F3"
                                          BorderThickness="2"
                                          CornerRadius="8"
                                          Background="{DynamicResource MaterialDesignPaper}"
                                          Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding SelectLocalCommand}" MouseAction="LeftClick"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0.6"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedStrategy}" Value="KeepLocal">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter Property="Background" Value="#E3F2FD"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.8"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid Margin="16">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <StackPanel Grid.Row="0"
                                                      Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Laptop"
                                                                       Width="20"
                                                                       Height="20"
                                                                       Foreground="#2196F3"
                                                                       Margin="0,0,8,0"/>
                                                <TextBlock Text="Versione Locale"
                                                         Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                                         Foreground="#2196F3"/>
                                            </StackPanel>

                                            <!-- Details -->
                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="{Binding LocalVersion.EntityName}"
                                                         Style="{StaticResource MaterialDesignBody1TextBlock}"
                                                         FontWeight="SemiBold"
                                                         Margin="0,0,0,8"/>

                                                <StackPanel Orientation="Horizontal"
                                                          Margin="0,0,0,12">
                                                    <materialDesign:PackIcon Kind="ClockOutline"
                                                                           Width="16"
                                                                           Height="16"
                                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                           Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding LocalVersion.Timestamp, StringFormat='dd/MM/yyyy HH:mm'}"
                                                             Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                </StackPanel>

                                                <!-- Detail Fields -->
                                                <ItemsControl ItemsSource="{Binding LocalVersion.Details}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                         Text="{Binding Key}"
                                                                         Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                         FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="2"
                                                                         Text="{Binding Value}"
                                                                         Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                                         TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- VS Separator -->
                                    <StackPanel Grid.Column="1"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center">
                                        <Border Background="{DynamicResource MaterialDesignDivider}"
                                              Width="2"
                                              Height="40"
                                              Margin="0,0,0,8"/>
                                        <TextBlock Text="vs"
                                                 Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                 FontWeight="Bold"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,0,0,8"/>
                                        <Border Background="{DynamicResource MaterialDesignDivider}"
                                              Width="2"
                                              Height="40"/>
                                    </StackPanel>

                                    <!-- REMOTE VERSION -->
                                    <Border Grid.Column="2"
                                          BorderBrush="#FF9800"
                                          BorderThickness="2"
                                          CornerRadius="8"
                                          Background="{DynamicResource MaterialDesignPaper}"
                                          Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding SelectRemoteCommand}" MouseAction="LeftClick"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0.6"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedStrategy}" Value="KeepRemote">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter Property="Background" Value="#FFF3E0"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.8"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid Margin="16">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <StackPanel Grid.Row="0"
                                                      Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CloudDownload"
                                                                       Width="20"
                                                                       Height="20"
                                                                       Foreground="#FF9800"
                                                                       Margin="0,0,8,0"/>
                                                <TextBlock Text="Versione Remota"
                                                         Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                                         Foreground="#FF9800"/>
                                            </StackPanel>

                                            <!-- Details -->
                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="{Binding RemoteVersion.EntityName}"
                                                         Style="{StaticResource MaterialDesignBody1TextBlock}"
                                                         FontWeight="SemiBold"
                                                         Margin="0,0,0,8"/>

                                                <StackPanel Orientation="Horizontal"
                                                          Margin="0,0,0,12">
                                                    <materialDesign:PackIcon Kind="ClockOutline"
                                                                           Width="16"
                                                                           Height="16"
                                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                           Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding RemoteVersion.Timestamp, StringFormat='dd/MM/yyyy HH:mm'}"
                                                             Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                </StackPanel>

                                                <!-- Detail Fields -->
                                                <ItemsControl ItemsSource="{Binding RemoteVersion.Details}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                         Text="{Binding Key}"
                                                                         Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                         FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="2"
                                                                         Text="{Binding Value}"
                                                                         Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                                         TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Merge Option (only for DuplicateVisit) -->
                                <Border Grid.Row="4"
                                      BorderBrush="#9C27B0"
                                      BorderThickness="2"
                                      CornerRadius="8"
                                      Background="{DynamicResource MaterialDesignPaper}"
                                      Cursor="Hand"
                                      Visibility="{Binding Type, Converter={StaticResource BoolToVisibility}}">
                                    <Border.InputBindings>
                                        <MouseBinding Command="{Binding SelectMergeCommand}" MouseAction="LeftClick"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                            <Style.Triggers>
                                                <!-- Show only for DuplicateVisit -->
                                                <DataTrigger Binding="{Binding Type}" Value="DuplicateVisit">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedStrategy}" Value="Merge">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Setter Property="Background" Value="#F3E5F5"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid Margin="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Grid.Column="0"
                                                               Kind="Merge"
                                                               Width="24"
                                                               Height="24"
                                                               Foreground="#9C27B0"/>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Unisci Entrambe le Versioni (Merge)"
                                                     Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                                     Foreground="#9C27B0"
                                                     Margin="0,0,0,4"/>
                                            <TextBlock Text="Le note di entrambe le visite verranno unite in un'unica registrazione."
                                                     Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                     TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Grid Grid.Row="3"
             Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status Message -->
            <TextBlock Grid.Column="0"
                     Text="{Binding StatusMessage}"
                     Style="{StaticResource MaterialDesignBody2TextBlock}"
                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"/>

            <!-- Cancel Button -->
            <Button Grid.Column="2"
                  Content="Annulla Importazione"
                  Command="{Binding CancelCommand}"
                  Style="{StaticResource MaterialDesignOutlinedButton}"
                  Height="40"
                  Padding="16,0"/>

            <!-- Apply Button -->
            <Button Grid.Column="4"
                  Content="Applica Risoluzioni"
                  Command="{Binding ApplyResolutionsCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Padding" Value="24,0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsApplying}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
